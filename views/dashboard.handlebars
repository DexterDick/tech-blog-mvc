{{#if posts.length}}
    {{#each posts}}
        <article class="card">
            <div class="card-header">
                <h3><a href="/post/{{id}}">{{title}}</a></h3>
                <p>Posted by
                    {{User.username}}
                    on
                    {{format_date createdAt}}</p>
            </div>

        </article>
    {{/each}}
{{else}}
    <p>No post to display</p>
{{/if}}