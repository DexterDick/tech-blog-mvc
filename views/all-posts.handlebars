{{#if posts.length}}
    {{#each posts}}
        <article class="card">
            <div class="card-header">
                <h3><a href="/post/{{id}}">{{title}}</a></h3>
                <p>Posted by
                    {{user.username}}
                    on
                    {{createdAt}}</p>
            </div>
            <div class="card-body">
                {{body}}
            </div>
        </article>
    {{/each}}
{{else}}
    <p>No current post to display</p>
{{/if}}